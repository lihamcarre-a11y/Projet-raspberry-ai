[Unit]
Description=Raspberry AI - serveur IA locale
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/raspberry-ai
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=qwen2.5:1.5b-instruct-q4_K_M
Environment=WHISPER_MODEL=base
Environment=PIPER_BIN=/home/%i/.local/bin/piper
Environment=PIPER_VOICE=fr_FR-siwis-medium
Environment=PIPER_DATA=/home/%i/.local/share/piper
ExecStart=/opt/raspberry-ai/.venv/bin/uvicorn server.main:app --host 0.0.0.0 --port 8000 --app-dir /opt/raspberry-ai
Restart=on-failure

[Install]
WantedBy=multi-user.target
